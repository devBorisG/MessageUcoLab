<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender (en texto, nivel INFO+) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                {
                "timestamp": "%date{yyyy-MM-dd'T'HH:mm:ss.SSS}",
                "level": "%level",
                "thread": "%thread",
                "logger": "%logger",
                "message": "%message",
                "mdc": "%mdc",
                "exception": "%ex"
                }
            </pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- Rolling File Appender (logs locales en JSON) -->
    <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>
                {
                "timestamp": "%date{yyyy-MM-dd'T'HH:mm:ss.SSS}",
                "level": "%level",
                "thread": "%thread",
                "logger": "%logger",
                "message": "%message",
                "mdc": "%mdc",
                "exception": "%ex"
                }
            </pattern>
        </encoder>
    </appender>

    <!-- Loki Appender (usando loki4j, en JSON) -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">

        <!-- Configuración HTTP (URL de Loki) -->
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>

        <!-- Formato (labels y mensaje) -->
        <format>
            <label>
                <!-- Etiquetas "estáticas" o con variables -->
                <pattern>
                    app = MessageUcoLab,
                    environment = dev
                </pattern>
                <!-- structuredMetadataPattern (Loki v2.9.0+): convierte campos en "metadata" -->
                <structuredMetadataPattern>
                    level = %level,
                    thread = %thread,
                    logger = %logger,
                    mdc = %mdc
                </structuredMetadataPattern>
            </label>

            <!-- Mensaje que verás en el panel de logs -->
            <message>
                <pattern>%date{HH:mm:ss.SSS} %-5level [%thread] %logger{36} [mdc=%mdc] - %msg %ex</pattern>
            </message>
        </format>

    </appender>


    <!-- Logger para MongoDB Driver (solo ERROR en consola y archivo, Loki también si quieres) -->
    <logger name="org.mongodb.driver" level="ERROR" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ROLLING" />
        <appender-ref ref="LOKI" />
    </logger>

    <!-- Logger general -->
    <logger name="me.mourjo" level="DEBUG">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING"/>
        <appender-ref ref="LOKI"/>
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING"/>
        <appender-ref ref="LOKI"/>
    </root>
</configuration>
