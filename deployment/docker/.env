# MONGOPASSWORD: La contraseña del usuario de MongoDB.
MONGOPASSWORD=password

# MONGODBHOST: El host de la base de datos MongoDB.
MONGODBHOST=mongodb-crosswords-db

# MONGODBUSER: El usuario de la base de datos MongoDB.
MONGODBUSER=usuario

# MONGODBPORT: El puerto de conexión a la base de datos MongoDB.
# Por defecto, MongoDB utiliza el puerto 27017.
MONGODBPORT=27017

# MONGODBDATABASE: El nombre de la base de datos en MongoDB.
MONGODBDATABASE=mi_base_de_datos

# Redis Configuration
# REDISPASSWORD: La contraseña para conectarse a Redis.
REDISPASSWORD=contraseña_redis

# REDISPORT: El puerto de conexión a Redis.
# Por defecto, Redis utiliza el puerto 6379.
REDISPORT=6379

# REDISHOST: El host de Redis.
REDISHOST=redis

# REDISDATABASE: El número de la base de datos en Redis.
# Redis permite múltiples bases de datos numeradas, por defecto es 0.
REDISDATABASE=0

# PostgreSQL Configuration
# POSTGRESHOST: El host del servidor de la base de datos PostgreSQL.
POSTGRESHOST=crs-crossword-db

# POSTGRESPORT: El puerto de conexión a la base de datos PostgreSQL.
# Por defecto, PostgreSQL utiliza el puerto 5432. Aquí se ha definido el puerto 5435.
POSTGRESPORT=5435

# POSTGRESDATABASE: El nombre de la base de datos PostgreSQL.
POSTGRESDATABASE=base_de_datos_escritura

# POSTGRESUSERNAME: El nombre de usuario para conectarse a PostgreSQL.
POSTGRESUSERNAME=postgres

# POSTGRESPASSWORD: La contraseña del usuario de PostgreSQL.
POSTGRESPASSWORD=postgres

# Grafana Configuration
# GF_SECURITY_ADMIN_PASSWORD: La contraseña del usuario administrador por defecto de Grafana.
GF_SECURITY_ADMIN_PASSWORD=admin

# AZURE_KEYVAULT_UCOLAB_ENDPOINT: La URL del endpoint del Azure Key Vault donde se almacenan los secretos.
# Asegura la gestion centralizada y segura de claves, secretos y certificados.
AZURE_KEYVAULT_UCOLAB_ENDPOINT= https://mi-vault-seguro.vault.azure.net/

# DOPPLERTOKEN: El token de acceso a Doppler, una herramienta de gestion de secretos.
# Este token se utiliza para autenticarse y recuperar configuraciones seguras.
DOPPLERTOKEN= dp.token_doppler

# PULSARURL: La URL del broker de Apache Pulsar que actua como sistema de mensajeria.
# Se utiliza para publicar y consumir mensajes dentro de un sistema distribuido.
PULSARURL=pulsar://pulsar-standalone:6650

# PULSARTOPICNAME: El nombre del topico (topic) de Apache Pulsar donde se publicaron o consumiron los mensajes.
# Este topico organiza los mensajes por canal logico dentro del sistema de mensajeria.
PULSARTOPICNAME=crossword-topic