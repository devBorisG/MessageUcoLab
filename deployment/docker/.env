# MongoDB Configuration
# MONGODBPASSWORD: Contraseña del usuario de MongoDB.
MONGODBPASSWORD=password

# MONGODBHOST: Host donde se encuentra el servidor de MongoDB.
MONGODBHOST=mongodb-crosswords-db

# MONGODBUSER: Usuario utilizado para autenticarse en MongoDB.
MONGODBUSER=usuario

# MONGODBPORT: Puerto de conexión a MongoDB. Por defecto es 27017.
MONGODBPORT=27017

# MONGODBDATABASE: Nombre de la base de datos MongoDB que se utilizará.
MONGODBDATABASE=mi_base_de_datos

# Redis Configuration
# REDISPASSWORD: Contraseña de autenticación para el servidor Redis.
REDISPASSWORD=contraseña_redis

# REDISPORT: Puerto utilizado para conectar con Redis. Por defecto es 6379.
REDISPORT=6379

# REDISHOST: Host donde se encuentra el servidor Redis.
REDISHOST=redis

# REDISDATABASE: Número de la base de datos Redis que se utilizará. Por defecto es 0.
REDISDATABASE=0

# PostgreSQL Configuration
# POSTGRESHOST: Host del servidor PostgreSQL.
POSTGRESHOST=crs-crossword-db

# POSTGRESPORT: Puerto de conexión a PostgreSQL. Por defecto es 5432, aquí se usa 5435.
POSTGRESPORT=5435

# POSTGRESDATABASE: Nombre de la base de datos PostgreSQL que se utilizará.
POSTGRESDATABASE=base_de_datos_escritura

# POSTGRESUSERNAME: Nombre de usuario para conectarse a PostgreSQL.
POSTGRESUSERNAME=postgres

# POSTGRESPASSWORD: Contraseña del usuario PostgreSQL.
POSTGRESPASSWORD=postgres

# Grafana Configuration
# GF_SECURITY_ADMIN_PASSWORD: Contraseña del usuario administrador por defecto en Grafana.
GF_SECURITY_ADMIN_PASSWORD=admin

# Azure Key Vault Configuration
# AZURE_KEYVAULT_UCOLAB_ENDPOINT: URL del endpoint de Azure Key Vault para gestionar secretos de forma centralizada y segura.
AZURE_KEYVAULT_UCOLAB_ENDPOINT=https://mi-vault-seguro.vault.azure.net/

# AZURE_CLIENT_ID: ID del cliente (aplicación) registrado en Azure AD.
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AZURE_CLIENT_SECRET: Secreto del cliente registrado en Azure AD.
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AZURE_TENANT_ID: ID del tenant (inquilino) de Azure Active Directory.
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Doppler Configuration
# DOPPLERTOKEN: Token de acceso para autenticarse en Doppler y recuperar secretos seguros.
DOPPLERTOKEN=dp.token_doppler

# Apache Pulsar Configuration
# PULSARURL: URL del broker de Apache Pulsar utilizado como sistema de mensajería.
PULSARURL=pulsar://pulsar-standalone:6650

# PULSARTOPICNAME: Nombre del tópico de Apache Pulsar para la publicación/consumo de mensajes.
PULSARTOPICNAME=crossword-topic