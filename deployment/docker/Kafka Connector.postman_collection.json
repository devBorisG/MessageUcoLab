		{
			"name": "Registrar conector",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"postgres-connector\",\n  \"config\": {\n    \"connector.class\": \"io.debezium.connector.postgresql.PostgresConnector\",\n    \"database.user\": \"postgres\",\n    \"database.dbname\": \"inventory\",\n    \"slot.name\": \"debezium_slot\",\n    \"tasks.max\": \"1\",\n    \"transforms\": \"unwrap\",\n    \"database.server.name\": \"inventory\",\n    \"database.port\": \"5432\",\n    \"plugin.name\": \"pgoutput\",\n    \"database.hostname\": \"postgres\",\n    \"database.password\": \"postgres\",\n    \"name\": \"postgres-connector\",\n    \"table.include.list\": \"public.categories,public.products\",\n\n    \"transforms.unwrap.type\": \"io.debezium.transforms.ExtractNewRecordState\",\n\n    \"transforms.unwrap.delete.handling.mode\": \"rewrite\",  \n\n    \"transforms.unwrap.add.fields\": \"op, ts_ms\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8083/connectors",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8083",
					"path": [
						"connectors"
					]
				}
			},
			"response": []
		},
		{
			"name": "Eliminar conector",
			"request": {
