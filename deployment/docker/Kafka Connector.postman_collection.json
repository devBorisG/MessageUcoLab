		{
			"name": "Actualizar conector",
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{    \n    \"connector.class\": \"com.mongodb.kafka.connect.MongoSinkConnector\",\n    \"key.projection.type\": \"AllowList\",\n    \"errors.log.include.messages\": \"true\",\n    \"transforms.ExtractKey.type\": \"org.apache.kafka.connect.transforms.ValueToKey\",\n    \"tasks.max\": \"1\",\n    \"topics\": \"PRODUCT_WITH_CATEGORY\",\n    \"key.projection.list\": \"PRODUCT_ID\",\n    \"transforms\": \"ExtractKey\",\n    \"delete.on.null.values\": \"true\",\n    \"transforms.ExtractKey.fields\": \"PRODUCT_ID\",\n    \"collection\": \"products_enriched\",\n    \"key.converter.schemas.enable\": \"false\",\n    \"database\": \"inventory\",\n    \"document.id.strategy\": \"com.mongodb.kafka.connect.sink.processor.id.strategy.ProvidedInKeyStrategy\",\n    \"connection.uri\": \"mongodb://mongodb:27017\",\n    \"value.converter.schemas.enable\": \"false\",\n    \"name\": \"mongodb-sink-connector-4\",\n    \"errors.tolerance\": \"all\",\n    \"value.converter\": \"org.apache.kafka.connect.json.JsonConverter\",\n    \"errors.log.enable\": \"true\",\n    \"key.converter\": \"org.apache.kafka.connect.json.JsonConverter\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8083/connectors/mongodb-sink-connector-4/config",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8083",
					"path": [
						"connectors",
						"mongodb-sink-connector-4",
						"config"
					]
				}
			},
			"response": []
